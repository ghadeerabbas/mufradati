  {
   "id": "k4-weihnachten",
   "c": "k4",
   "t": "Weihnachten",
   "tar": "عيد الميلاد",
   "v": 1,
   "p": [
    [
     {
      "de": "Markt und Strassen steh'n verlassen",
      "ar": "السوقُ والشوارعُ مهجورة"
     },
     {
      "de": "still erleuchtet jedes Haus",
      "ar": "كلُّ بيتٍ مُضاءٌ بهدوء"
     },
     {
      "de": "sinnend geh ich durch die Gassen",
      "ar": "أمشي متأمّلًا في الأزقّة"
     },
     {
      "de": "alles sieht so festlich aus.",
      "ar": "كلُّ شيءٍ يبدو احتفاليًّا جدًّا."
     }
    ],
    [
     {
      "de": "An den Fenstern haben Frauen",
      "ar": "عند النوافذ زيّنت نساءٌ"
     },
     {
      "de": "buntes Spielzeug fromm geschmückt",
      "ar": "ألعابًا ملوّنةً بخشوع"
     },
     {
      "de": "tausend Kindlein steh'n und schauen",
      "ar": "ألفُ طفلٍ صغيرٍ يقفون وينظرون"
     },
     {
      "de": "sind so wunderstill beglückt.",
      "ar": "سعداءُ جدًّا في سكونٍ عجيب."
     }
    ],
    [
     {
      "de": "Und ich wandre aus den Mauern",
      "ar": "وأمشي خارجًا من الأسوار"
     },
     {
      "de": "bis hinaus ins freie Feld",
      "ar": "حتى الخارج إلى الحقل الفسيح"
     },
     {
      "de": "hehres Glänzen, heil'ges Schauen",
      "ar": "لمعانٌ مهيب، تأمّلٌ مقدّس"
     },
     {
      "de": "wie so weit und still die Welt!",
      "ar": "ما أوسعَ العالمَ وما أهدأه!"
     }
    ],
    [
     {
      "de": "Sterne hoch die Kreise schlingen",
      "ar": "النجومُ في الأعالي تنسجُ الدوائر"
     },
     {
      "de": "aus des Schnee's Einsamkeit",
      "ar": "من وحدةِ الثلج"
     },
     {
      "de": "steigt's wie wunderbares Singen",
      "ar": "يصعدُ كغناءٍ رائع"
     },
     {
      "de": "Oh Du gnadenreiche Zeit!",
      "ar": "أيها الزمنُ الغنيُّ بالنعمة!"
     }
    ]
   ],
