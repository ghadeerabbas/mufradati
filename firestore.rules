rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == "admin@mufradati.app"; }
    // الحساب المفعّل: المشرف، أو من فعّله المشرف، أو المستخدمون القدامى (لهم سجلّ تقدّم)
    function active() {
      return isAdmin() || (signedIn() && (exists(/databases/$(database)/documents/members/$(request.auth.uid))
        || exists(/databases/$(database)/documents/users/$(request.auth.uid))));
    }
    function isMe(uid) { return signedIn() && request.auth.uid == uid && active(); }

    // التفعيل: يقرأ المستخدم حالته، ويطلب التفعيل، والمشرف وحده يفعّل
    match /members/{uid} { allow read: if isAdmin() || (signedIn() && request.auth.uid == uid); allow write: if isAdmin(); }
    match /join/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name","ts"])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.ts == request.time;
    }

    // تقدّم كل مستخدم: يكتبه الخادم وحده، ويقرؤه صاحبه والمدير
    // التطبيق يكتب فقط الملخّص والاسم والتفضيلات (المظهر واتجاه البطاقة)
    function okUserFields(d) {
      return (!("prefs" in d) || (d.prefs is string && d.prefs.size() <= 4000))
        && (!("name" in d) || (d.name is string && d.name.size() <= 60))
        && (!("sum" in d) || d.sum is map);
    }
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid) && request.resource.data.keys().hasOnly(["sum","name","prefs","updated"]) && okUserFields(request.resource.data);
      allow update: if isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sum","name","prefs","updated"]) && okUserFields(request.resource.data);
      allow delete: if false;
    }
    match /users/{uid}/{rest=**} { allow read: if isMe(uid) || isAdmin(); allow write: if false; }

    // إعدادات التطبيق (الأرقام والمتجر): يقرؤها المسجَّلون، ويكتبها المشرف وحده
    match /config/{doc} { allow read: if active(); allow write: if isAdmin(); }

    // المناهج المعيّنة لكل مستخدم: يعيّنها المدير وحده، ويقرؤها المستخدم
    match /assign/{uid} { allow read: if isMe(uid) || isAdmin(); allow write: if isAdmin(); }

    // هدايا الجواهر: يرسلها المدير وحده، ويقرؤها صاحبها والمدير
    match /gifts/{uid}/g/{gid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(["g","note","ts"])
        && request.resource.data.g is int && request.resource.data.g >= 1 && request.resource.data.g <= 100000
        && request.resource.data.note is string && request.resource.data.note.size() <= 100
        && request.resource.data.ts == request.time;
      allow update, delete: if isAdmin();
    }

    // الملف العام: يراه كل المسجَّلين، ويكتبه الخادم وحده
    match /pub/{uid} { allow read: if active(); allow write: if false; }

    // الاسم الظاهر: يقترحه المستخدم، ويوافق عليه المدير، ويُغيَّر مرة كل ٧ أيام
    match /names/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(["pending","reqAt"])
        && request.resource.data.pending is string && request.resource.data.pending.size() <= 40
        && request.resource.data.reqAt == request.time;
      allow update: if isMe(uid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rej"]) && request.resource.data.rej == "")
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pending","reqAt"])
            && request.resource.data.pending is string && request.resource.data.pending.size() <= 40
            && request.resource.data.reqAt == request.time
            && (!("okAt" in resource.data) || request.time > resource.data.okAt + duration.value(7, "d"))));
    }

    // الدوري الأسبوعي: يراه كل المسجَّلين، ويكتبه الخادم وحده
    match /lg/{week}/m/{uid} { allow read: if active(); allow write: if false; }

    // التقييم: مرة واحدة لكل مستخدم، ويقرؤه هو والمدير
    match /feedback/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(["stars","note","name","ts"])
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }

    // الرسائل: رسالة واحدة من المستخدم ثم ينتظر رد المدير
    match /threads/{uid} {
      function userSend() {
        let d = request.resource.data;
        return d.keys().hasOnly(["name","state","lastFrom","unreadUser","updated","lastMsg","userClr","adminClr"])
          && (resource == null || d.get("adminClr", null) == resource.data.get("adminClr", null))
          && d.state == "waiting" && d.lastFrom == "user" && d.unreadUser == false
          && d.updated == request.time && d.name is string && d.name.size() <= 60;
      }
      allow read: if isAdmin() || isMe(uid);
      allow create: if isMe(uid) && userSend();
      allow update: if isAdmin()
        || (isMe(uid) && resource.data.state == "open" && userSend())
        || (isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["unreadUser"])
            && request.resource.data.unreadUser == false)
        || (isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["userClr"])
            && request.resource.data.userClr == request.time);
      allow delete: if isAdmin();

      match /msgs/{mid} {
        function validMsg(from) {
          let d = request.resource.data;
          return d.keys().hasOnly(["from","text","ts"]) && d.from == from
            && d.text is string && d.text.size() > 0 && d.text.size() <= 500 && d.ts == request.time
            && getAfter(/databases/$(database)/documents/threads/$(uid)).data.lastMsg == mid;
        }
        allow read: if isAdmin() || isMe(uid);
        allow create: if (isAdmin() && validMsg("admin"))
          || (isMe(uid) && validMsg("user")
              && (!exists(/databases/$(database)/documents/threads/$(uid))
                  || get(/databases/$(database)/documents/threads/$(uid)).data.state == "open")
              && getAfter(/databases/$(database)/documents/threads/$(uid)).data.state == "waiting");
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
