rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == "ghadeer@mufradati.app"; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // تقدّم كل مستخدم: يكتبه هو وحده، ويقرؤه هو والمدير
    match /users/{uid} { allow read: if isMe(uid) || isAdmin(); allow write: if isMe(uid); }
    match /users/{uid}/{rest=**} { allow read: if isMe(uid) || isAdmin(); allow write: if isMe(uid); }

    // المناهج المعيّنة لكل مستخدم: يعيّنها المدير وحده، ويقرؤها المستخدم
    match /assign/{uid} { allow read: if isMe(uid) || isAdmin(); allow write: if isAdmin(); }

    // هدايا الجواهر: يرسلها المدير وحده، ويقرؤها صاحبها والمدير
    match /gifts/{uid}/g/{gid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(["g","note","ts"])
        && request.resource.data.g is int && request.resource.data.g >= 1 && request.resource.data.g <= 100000
        && request.resource.data.note is string && request.resource.data.note.size() <= 100
        && request.resource.data.ts == request.time;
      allow update, delete: if isAdmin();
    }

    // الملف العام: يراه كل المسجَّلين، ويكتبه صاحبه وحده
    match /pub/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid)
        && request.resource.data.keys().hasOnly(["name","av","nc","fr","lv","xp","streak","best","tier","title","alv","stk","ts"])
        && request.resource.data.name is string && shownName(uid, request.resource.data.name)
        && (!("nc" in request.resource.data) || !(request.resource.data.nc in ["admin", "crimson", "black"]) || isAdmin())
        && request.resource.data.stk is list && request.resource.data.stk.size() <= 40
        && request.resource.data.alv is map && request.resource.data.ts == request.time;
    }

    // الاسم الظاهر: يقترحه المستخدم، ويوافق عليه المدير، ويُغيَّر مرة كل ٧ أيام
    match /names/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(["pending","reqAt"])
        && request.resource.data.pending is string && request.resource.data.pending.size() <= 40
        && request.resource.data.reqAt == request.time;
      allow update: if isMe(uid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rej"]) && request.resource.data.rej == "")
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pending","reqAt"])
            && request.resource.data.pending is string && request.resource.data.pending.size() <= 40
            && request.resource.data.reqAt == request.time
            && (!("okAt" in resource.data) || request.time > resource.data.okAt + duration.value(7, "d"))));
    }
    // الاسم الذي يظهر في الدوري: الموافَق عليه، وإلا فاسم الدخول
    function shownName(uid, n) {
      let p = /databases/$(database)/documents/names/$(uid);
      return (exists(p) && get(p).data.get("name", "") != "" && n == get(p).data.name)
        || ((!exists(p) || get(p).data.get("name", "") == "") && n == request.auth.token.email.split("@")[0]);
    }

    // الدوري الأسبوعي: يراه كل المسجَّلين، ويكتب كل مستخدم سطره وحده
    match /lg/{week}/m/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(["name","av","fr","st","nc","solo","tier","grp","b","xp","ts"])
        && (!("solo" in request.resource.data) || (request.resource.data.solo is bool && isAdmin()))
        && (!("nc" in request.resource.data) || (request.resource.data.nc is string && request.resource.data.nc.size() <= 16
            && (!(request.resource.data.nc in ["admin", "crimson", "black"]) || isAdmin())))
        && (!("fr" in request.resource.data) || (request.resource.data.fr is string && request.resource.data.fr.size() <= 16))
        && (!("st" in request.resource.data) || (request.resource.data.st is string && request.resource.data.st.size() <= 8))
        && request.resource.data.name is string && shownName(uid, request.resource.data.name)
        && request.resource.data.av is string && request.resource.data.av.size() <= 8
        && request.resource.data.tier is int && request.resource.data.tier >= 0 && request.resource.data.tier <= 9
        && request.resource.data.grp is int && request.resource.data.grp >= 0 && request.resource.data.grp < 1000
        && request.resource.data.b is int && request.resource.data.b >= 0 && request.resource.data.b <= 5
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 100000
        && request.resource.data.ts == request.time;
      allow delete: if false;
    }

    // التقييم: مرة واحدة لكل مستخدم، ويقرؤه هو والمدير
    match /feedback/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(["stars","note","name","ts"])
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }

    // الرسائل: رسالة واحدة من المستخدم ثم ينتظر رد المدير
    match /threads/{uid} {
      function userSend() {
        let d = request.resource.data;
        return d.keys().hasOnly(["name","state","lastFrom","unreadUser","updated","lastMsg","userClr","adminClr"])
          && (resource == null || d.get("adminClr", null) == resource.data.get("adminClr", null))
          && d.state == "waiting" && d.lastFrom == "user" && d.unreadUser == false
          && d.updated == request.time && d.name is string && d.name.size() <= 60;
      }
      allow read: if isAdmin() || isMe(uid);
      allow create: if isMe(uid) && userSend();
      allow update: if isAdmin()
        || (isMe(uid) && resource.data.state == "open" && userSend())
        || (isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["unreadUser"])
            && request.resource.data.unreadUser == false)
        || (isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["userClr"])
            && request.resource.data.userClr == request.time);
      allow delete: if isAdmin();

      match /msgs/{mid} {
        function validMsg(from) {
          let d = request.resource.data;
          return d.keys().hasOnly(["from","text","ts"]) && d.from == from
            && d.text is string && d.text.size() > 0 && d.text.size() <= 500 && d.ts == request.time
            && getAfter(/databases/$(database)/documents/threads/$(uid)).data.lastMsg == mid;
        }
        allow read: if isAdmin() || isMe(uid);
        allow create: if (isAdmin() && validMsg("admin"))
          || (isMe(uid) && validMsg("user")
              && (!exists(/databases/$(database)/documents/threads/$(uid))
                  || get(/databases/$(database)/documents/threads/$(uid)).data.state == "open")
              && getAfter(/databases/$(database)/documents/threads/$(uid)).data.state == "waiting");
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
